    <string name="nav_trips">My trips</string>
    <!-- Main navigation entry.<lh>{"labels":["ui"]}</lh> -->
    <string name="nav_explore">Explore</string>
    <!-- Main navigation entry.<lh>{"labels":["ui"]}</lh> -->
    <string name="nav_profile">Profile</string>
    <!-- Home screen greeting after login. {{userName}} is the traveler's first name.<lh>{"labels":["ui"]}</lh> -->
    <string name="trips_greeting">Welcome back, %1$s! Where to next?</string>
    <!-- Trip card subtitle. {{destination}} is a city name, {{startDate}} a localized date.<lh>{"labels":["ui"]}</lh> -->
    <string name="trips_summary">Your itinerary for %1$s starts on %2$s.</string>
    <plurals name="trips_members">
        <item quantity="one">%1$d traveler</item>
        <item quantity="other">%1$d travelers</item>
    </plurals>
