    <!-- Full-screen error when the connection drops.<lh>{"labels":["errors"]}</lh> -->
    <string name="errors_offline">You\'re offline. Even Wanderly can\'t route around the internet.</string>
    <!-- Inline error on the payment form.<lh>{"labels":["errors"]}</lh> -->
