    <string name="app_tagline">Plan trips together. Argue about the itinerary later.</string>
    <!-- The source text used by the onboarding LINA comparison.<lh>{"labels":["tour"]}</lh> -->
    <string name="app_context_comparison">Plan your next trip to %1$s with Wanderly. Create the itinerary, invite your friends, and start exploring.</string>
